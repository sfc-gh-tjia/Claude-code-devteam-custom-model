# Copy to gateway/.env (gitignored, never commit it) and fill in the keys your tiers use.
# Models and endpoints are NOT configured here; they live in gateway/tiers.toml.

# Keys: one per provider used in tiers.toml (api_key_env). Remove a provider's tiers to drop its key.
DEEPSEEK_API_KEY=            # https://platform.deepseek.com/api_keys
NVIDIA_API_KEY=              # https://build.nvidia.com -> "Get API Key" (free)
# OPENROUTER_API_KEY=        # only if you add an OpenRouter tier
# TOGETHER_API_KEY=          # ... and so on for any provider you add

# Optional endpoint overrides (tiers.toml reads them via ${VAR:-default}), e.g. a corporate proxy
# or an approved host serving the same open weights:
# DEEPSEEK_API_BASE=https://api.deepseek.com
# NVIDIA_API_BASE=https://integrate.api.nvidia.com/v1
# LOCAL_API_BASE=http://127.0.0.1:8000/v1

# Which tier serves each role: gateway/profiles/<PROFILE>.toml
#   baseline (default) · glm-free · flash-first · thrift      `make profile` shows the map
PROFILE=baseline

GATEWAY_PORT=4000
GATEWAY_KEY=sk-devteam-local   # local-only token Claude Code sends; must match .claude/settings.json
